{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cashflow.example.invalid/contracts/transaction-recorded.v1.schema.json",
  "title": "TransactionRecorded event | CashFlow MVP",
  "description": "Contrato proposto v1: payload durável de registro financeiro confirmado. URL $id é identificador de schema ilustrativo, não serviço hospedado.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "correlation_id",
    "occurred_at",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "transaction.recorded"
    },
    "schema_version": {
      "const": "1"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "Instante UTC de criação do evento"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id",
        "merchant_id",
        "type",
        "amount",
        "currency",
        "reference_date",
        "created_at"
      ],
      "properties": {
        "transaction_id": {
          "type": "string",
          "format": "uuid"
        },
        "merchant_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "enum": [
            "CREDIT",
            "DEBIT"
          ]
        },
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "description": "Montante BRL positivo, duas casas, rejeitar zero e overflow no domínio"
        },
        "currency": {
          "const": "BRL"
        },
        "reference_date": {
          "type": "string",
          "format": "date"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp de persistência original, UTC"
        }
      }
    }
  }
}
