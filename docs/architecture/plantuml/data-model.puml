@startuml CashFlow_Data_Model
title CashFlow | Modelo lógico preliminar por domínio
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam entity {
 BackgroundColor #E8F2FA
 BorderColor #39779B
 FontColor #1F4259
}
package "Keycloak | modelo IAM conceitual (nao tabelas internas)" #FDF6EB {
  entity "Usuario OIDC" as U {
    * subject_id : STRING <<sub>>
    --
    login_identifier : STRING
    status : STRING
  }
  entity "Grupo comerciante" as KG {
    * merchant_id : UUID <<ID estavel / caminho de grupo>>
    --
    group_path : /merchants/{merchant_uuid}
  }
  entity "Vinculo usuario/grupo" as KM {
    * subject_id : STRING <<sub>>
    * merchant_id : UUID
    --
    role : ADMIN | OPERATOR
    status : vigente | revogado
  }
  U ||--o{ KM : participa
  KG ||--o{ KM : define contexto
}
note bottom of KM
  Modelo logico conceitual para autorizacao.
  Keycloak Groups e fonte de verdade de vinculos
  e papeis por merchant_id; estrutura interna
  do banco IAM nao e contrato do CashFlow.
  Consultar vinculo atual por operacao;
  inicialmente sem cache positivo, fail closed.
  Nao ha banco proprio de Authorization.
end note
package "Contexto: Lançamentos\nBanco de lançamentos" #F4F8FC {
  entity "Transaction" as T {
    * id : UUID <<PK>>
    --
    merchant_id : UUID <<identificador externo>>
    type : CREDIT | DEBIT
    amount : NUMERIC(19,2) <<BRL, > 0>>
    reference_date : DATE <<competencia informada>>
    created_at : TIMESTAMPTZ <<instante UTC>>
    actor_id : STRING <<OIDC sub / referencia>>
    ' reversal_of_id reservado para estorno futuro
  }
  entity "OutboxEvent" as O {
    * id : UUID <<PK>>
    --
    transaction_id : UUID <<FK>>
    event_type : STRING
    correlation_id : UUID <<metadata>>
    schema_version : STRING
    payload : JSON
    created_at : TIMESTAMP
    published_at : TIMESTAMP (opcional)
    status : STRING
  }
  entity "HttpIdempotencyRecord" as I {
    * id : UUID <<PK>>
    --
    merchant_id : UUID
    idempotency_key : STRING
    request_hash : STRING
    transaction_id : UUID
  }
  entity "AuditEvent" as A {
    * id : UUID <<PK>>
    --
    transaction_id : UUID (opcional)
    merchant_id : UUID <<identificador externo>>
    actor_id : STRING <<OIDC sub / referencia>>
    action : STRING
    occurred_at : TIMESTAMP
    correlation_id : UUID
    outcome : STRING
  }
  T ||--o{ I : registro idempotente
  T ||--o{ O : origina
  T |o--o{ A : auditoria
}
package "Contexto: Consolidado Diário\nBanco do consolidado" #F0F8F3 {
  entity "DailyBalance" as D {
    * merchant_id : UUID <<PK composta>>
    * reference_date : DATE <<PK composta>>
    --
    credit_total : NUMERIC(19,2)
    debit_total : NUMERIC(19,2)
    net_amount : NUMERIC(19,2)
    ' closing_balance calculado na leitura
    updated_at : TIMESTAMP
  }
  entity "ProcessedEvent" as P {
    * event_id : UUID <<PK / UNIQUE>>
    --
    transaction_id : UUID
    merchant_id : UUID
    processed_at : TIMESTAMP
  }
}
O ..> P : evento publicado
P ..> D : atualiza atomica

note right of T
  O merchant_id e validado contra o vinculo atual\n  no Keycloak antes da operacao;
  nunca confiar somente na entrada do cliente.
  Actor_id e uma referencia ao sub do OIDC.
  Nao assumir que todo sub e UUID.
end note
note bottom of D
  Segregacao por comerciante aprovada.
  ProcessedEvent exige event_id unico.
  Persistir totais diarios; saldo
  acumulado calculado na leitura.
  Saldo inicial zero por comerciante no MVP.
  Dia vazio: movimento zero e saldo mantido.
  Nao exige linha para todo dia sem eventos.
  Competencias passadas/atuais aceitas.
  Futuras rejeitadas; recompor acumulados.
  Sem closing_balance persistido.
  Estorno fora do MVP.
  BRL duas casas; entradas > 0.
end note
@enduml
