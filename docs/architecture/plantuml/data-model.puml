@startuml CashFlow_Data_Model
title CashFlow | Modelo lógico preliminar por domínio
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam entity {
 BackgroundColor #E8F2FA
 BorderColor #39779B
 FontColor #1F4259
}
package "Provedor de identidade: Keycloak\nBanco gerenciado pelo Keycloak" #FDF6EB {
  entity "Usuario Keycloak (referencia)" as U {
    * subject_id : STRING <<OIDC sub>>
    --
    login_identifier : STRING
    status : STRING
  }
}
package "Contexto: Autorizacao CashFlow\nBanco logico proprio (MVP)" #FDF6EB {
  entity "Merchant" as MT {
    * id : UUID <<PK>>
    --
    display_name : STRING
    status : STRING
  }
  entity "Membership" as MB {
    * id : UUID <<PK>>
    --
    subject_id : STRING <<OIDC sub>>
    merchant_id : UUID
    status : STRING
  }
  entity "Role" as R {
    * id : UUID <<PK>>
    --
    code : STRING
  }
  entity "MembershipRole" as MR {
    * membership_id : UUID <<FK>>
    * role_id : UUID <<FK>>
  }
  entity "Permission" as PE {
    * id : UUID <<PK>>
    --
    code : STRING
  }
  entity "RolePermission" as RP {
    * role_id : UUID <<FK>>
    * permission_id : UUID <<FK>>
  }
  MT ||--o{ MB : permite
  MB ||--o{ MR : recebe
  R ||--o{ MR : atribuida
  R ||--o{ RP : concede
  PE ||--o{ RP : corresponde
}
U ..> MB : subject_id (sem FK)
package "Contexto: Lançamentos\nBanco de lançamentos" #F4F8FC {
  entity "Transaction" as T {
    * id : UUID <<PK>>
    --
    merchant_id : UUID <<identificador externo>>
    type : CREDIT | DEBIT
    amount : NUMERIC(19,2) <<BRL, > 0>>
    reference_date : DATE <<competencia informada>>
    created_at : TIMESTAMPTZ <<instante UTC>>
    actor_id : STRING <<OIDC sub / referencia>>
    ' reversal_of_id reservado para estorno futuro
  }
  entity "OutboxEvent" as O {
    * id : UUID <<PK>>
    --
    transaction_id : UUID <<FK>>
    event_type : STRING
    correlation_id : UUID <<metadata>>
    schema_version : STRING\n    payload : JSON
    created_at : TIMESTAMP
    published_at : TIMESTAMP (opcional)
    status : STRING
  }
  entity "HttpIdempotencyRecord" as I {\n    * id : UUID <<PK>>\n    --\n    merchant_id : UUID\n    idempotency_key : STRING\n    request_hash : STRING\n    transaction_id : UUID\n  }\n  entity "AuditEvent" as A {
    * id : UUID <<PK>>
    --
    transaction_id : UUID (opcional)
    merchant_id : UUID <<identificador externo>>
    actor_id : STRING <<OIDC sub / referencia>>
    action : STRING
    occurred_at : TIMESTAMP
    correlation_id : UUID
    outcome : STRING
  }
  T ||--o{ I : registro idempotente\n  T ||--o{ O : origina
  T |o--o{ A : auditoria
}
package "Contexto: Consolidado Diário\nBanco do consolidado" #F0F8F3 {
  entity "DailyBalance" as D {
    * merchant_id : UUID <<PK composta>>
    * reference_date : DATE <<PK composta>>
    --
    credit_total : NUMERIC(19,2)
    debit_total : NUMERIC(19,2)
    net_amount : NUMERIC(19,2)
    closing_balance : NUMERIC(19,2) <<materializacao a definir>>
    updated_at : TIMESTAMP
  }
  entity "ProcessedEvent" as P {
    * event_id : UUID <<PK / UNIQUE>>
    --
    transaction_id : UUID
    merchant_id : UUID
    processed_at : TIMESTAMP
  }
}
O ..> P : evento publicado
P ..> D : atualiza atomica
note bottom of MT
  Keycloak autentica e gerencia usuarios.
  CashFlow gerencia merchants e vinculos.
  Banco logico proprio de autorizacao.\n  ADMIN e OPERATOR por comerciante.
  Sem FK fisica entre os dominios.
end note
note right of T
  O merchant_id vem do contexto autorizado,
  nunca somente de entrada nao confiavel.
  Actor_id e uma referencia ao sub do OIDC.
  Nao assumir que todo sub e UUID.
end note
note bottom of D
  Segregacao por comerciante aprovada.
  ProcessedEvent exige event_id unico.
  Persistir totais diarios; saldo\n  acumulado calculado na leitura.
  Saldo inicial zero por comerciante no MVP.
  Dia vazio: movimento zero e saldo mantido.
  Nao exige linha para todo dia sem eventos.
  Competencias passadas/atuais aceitas.
  Futuras rejeitadas; recompor acumulados.
  Sem closing_balance persistido.\n  Estorno fora do MVP.
  BRL duas casas; entradas > 0.
end note
@enduml
