@startuml CashFlow_Containers
!include <C4/C4_Container>

title CashFlow | C4 Nível 2: Contêineres
LAYOUT_TOP_DOWN()

Person(comerciante, "Comerciante", "Lançamentos e consultas")
Person(admin, "Administrador", "Usuários e permissões")

System_Boundary(cashflow, "CashFlow") {
  Container(web, "Frontend", "React / TypeScript", "SPA executada no navegador")
  Container(nginx, "NGINX", "HTTP interno :8080", "Arquivos estáticos e proxy /api/v1/*")
  Container(iam, "Keycloak", "OIDC + Groups / HTTPS :443", "Identidades, tokens, JWKS e vinculos ADMIN/OPERATOR por comerciante")
  ContainerDb(db_iam, "Banco Keycloak", "PostgreSQL / TCP :5432", "Identidades, grupos, papeis e configuracao")

  Container(transactions, "Transactions", ".NET 10 / HTTP :8080", "API de lançamentos e Outbox worker")
  Container(consolidation, "Consolidation", ".NET 10 / HTTP :8080", "API de saldo e consumidor")
  ContainerQueue(rabbitmq, "RabbitMQ", "AMQP / TCP :5672", "Mensagens financeiras")
  ContainerDb(db_transactions, "Banco Transactions", "PostgreSQL / TCP :5432", "Lançamentos e Outbox")
  ContainerDb(db_consolidation, "Banco Consolidation", "PostgreSQL / TCP :5432", "Totais diários e eventos processados")
  Container(observability, "Observabilidade", "OTLP :4317 / :4318", "Collector, Prometheus, Loki, Tempo e Grafana")
}

' Agrupamento visual: borda e IAM na parte superior;
' serviços financeiros no centro; dados e telemetria abaixo.
Lay_R(comerciante, admin)
Lay_D(web, nginx)
Lay_R(nginx, iam)
Lay_D(iam, db_iam)
Lay_D(nginx, transactions)
Lay_R(transactions, consolidation)
Lay_D(transactions, db_transactions)
Lay_D(consolidation, db_consolidation)
Lay_D(transactions, rabbitmq)
Lay_D(rabbitmq, observability)

Rel(comerciante, web, "Usa a aplicação", "HTTPS :443")
Rel(admin, web, "Administra acessos", "HTTPS :443")
Rel(web, nginx, "Busca assets e acessa /api/v1/*", "HTTPS :443 externo")
Rel(web, iam, "Login OIDC + PKCE", "HTTPS :443")

' Integração opcional na borda, NÃO presente no template atual.
' Exigiria auth_request e um serviço adaptador OIDC, ou equivalente.
Rel(nginx, iam, "Opcional futuro: auth_request + adaptador", "HTTPS :443")

Rel(nginx, transactions, "Proxy + Bearer JWT", "HTTP :8080")
Rel(nginx, consolidation, "Proxy + Bearer JWT", "HTTP :8080")

' A validação JWT é feita localmente em CADA API.
' As conexoes JWKS/metadata sao sob demanda e usam cache.
' A autorizacao financeira consulta o vinculo atual no Keycloak por operacao;
' sem cache positivo de permissoes inicialmente; falha de IAM = fail closed.
Rel(transactions, iam, "JWKS sob demanda + verifica vinculo atual por merchant_id e acao", "HTTPS / API interna autenticada")
Rel(consolidation, iam, "JWKS sob demanda + verifica vinculo atual por merchant_id e acao", "HTTPS / API interna autenticada")

Rel(iam, db_iam, "Persiste identidades, grupos e papeis", "TCP :5432")
Rel(transactions, db_transactions, "Grava lançamento, idempotência, auditoria + Outbox", "TCP :5432")
Rel(consolidation, db_consolidation, "Atualiza totais diários; calcula acumulado", "TCP :5432")
Rel(transactions, rabbitmq, "Publica Outbox", "AMQP :5672")
Rel(consolidation, rabbitmq, "Consome; ACK após commit", "AMQP :5672")

' Para reduzir cruzamentos, a telemetria aparece como relação agrupada.
Rel(transactions, observability, "Envia telemetria", "OTLP :4317 / :4318")
Rel(consolidation, observability, "Envia telemetria", "OTLP :4317 / :4318")

SHOW_LEGEND()
@enduml
