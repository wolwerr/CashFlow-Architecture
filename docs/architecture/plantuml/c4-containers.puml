@startuml CashFlow_Containers
!include <C4/C4_Container>

title CashFlow | C4 Nível 2: Arquitetura da Solução

LAYOUT_TOP_DOWN()

Person(comerciante, "Comerciante", "Registra lançamentos e consulta saldos")
Person(admin, "Administrador de acessos", "Gerencia usuários e permissões")

System_Boundary(cashflow, "CashFlow") {
  Container(web, "Aplicação Web/Mobile", "Web / Mobile", "Interface financeira e administrativa")
  Container(gateway, "API Gateway", "HTTPS / REST", "Roteamento e controles de acesso")
  Container(iam, "Keycloak", "OIDC / OAuth 2.0", "Identidades, login, sessões e tokens")
  ContainerDb(db_iam, "Banco do Keycloak", "Persistência IAM", "Usuários, credenciais e configuração do provedor")
  Container(lancamentos, "Serviço de lançamentos", "API REST + Outbox", "Registra créditos e débitos")
  ContainerDb(db_lancamentos, "Banco de lançamentos", "Banco transacional", "Movimentações, auditoria e Outbox")
  ContainerQueue(mensageria, "Mensageria", "Broker de eventos", "Distribui eventos financeiros")
  Container(consolidado, "Serviço de consolidado", "API REST + consumidor", "Calcula e consulta saldos diários")
  ContainerDb(db_consolidado, "Banco do consolidado", "Banco de projeções", "Saldos e eventos processados")
  Container(telemetria, "Observabilidade", "OpenTelemetry", "Logs, métricas e traces")
}

' Posicionamento principal
Lay_R(comerciante, admin)
Lay_D(web, gateway)
Lay_D(gateway, iam)
Lay_D(iam, db_iam)
Lay_R(gateway, lancamentos)
Lay_D(lancamentos, db_lancamentos)
Lay_R(lancamentos, mensageria)
Lay_R(mensageria, consolidado)
Lay_D(consolidado, db_consolidado)
Lay_D(db_consolidado, telemetria)

' Atores e canais
Rel(comerciante, web, "Registra e consulta", "HTTPS")
Rel(admin, web, "Administra acessos", "HTTPS")
Rel_D(web, gateway, "Consome APIs", "HTTPS / JSON")

' Identidade
Rel_D(gateway, iam, "Administra identidades (proposto)", "HTTPS / REST")
Rel_D(iam, db_iam, "Persiste identidades e sessões", "SQL / TCP")

' Fluxo financeiro
Rel_R(gateway, lancamentos, "Registra movimentações", "HTTPS / REST")
Rel_D(lancamentos, db_lancamentos, "Persiste lançamento + Outbox", "SQL / TCP")
Rel_R(lancamentos, mensageria, "Publica eventos", "AMQP")
Rel_R(mensageria, consolidado, "Entrega eventos", "AMQP")
Rel_D(consolidado, db_consolidado, "Atualiza e consulta saldos", "SQL / TCP")
Rel(gateway, consolidado, "Consulta saldos", "HTTPS / REST")

' Integrações transversais apresentadas em notas
note right of iam
  Login via Keycloak e OIDC.
  APIs validam JWT localmente.
  Vínculos de comerciantes são
  autorizados no CashFlow.
end note

note right of telemetria
  Gateway, IAM e serviços
  financeiros exportam
  métricas, logs e traces
  via OTLP.
end note

SHOW_LEGEND()
@enduml
