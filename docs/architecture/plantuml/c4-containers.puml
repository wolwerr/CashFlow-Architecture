@startuml CashFlow_Containers
!include <C4/C4_Container>
title CashFlow | C4 Nível 2: Solução completa (proposta)
LAYOUT_LEFT_RIGHT()
Person(comerciante, "Comerciante", "Opera o caixa e consulta saldos")
Person(admin, "Administrador de acessos", "Gerencia contas e permissões")
System_Boundary(cashflow, "CashFlow") {
  Container(web, "Aplicação Web", "SPA (tecnologia a definir)", "Interface para lançamentos, saldos e administração")
  Container(gateway, "API Gateway", "HTTPS / REST", "Entrada única, roteamento e controles de borda")
  Container(iam, "Serviço de Identidade e Acessos", "IAM / OIDC (a definir)", "Login, cadastro, grupos e vínculos por comerciante")
  ContainerDb(db_iam, "Banco IAM", "Persistência a definir", "Identidades, papéis, permissões e vínculos")
  Container(lancamentos, "Serviço de lançamentos", "API REST + worker Outbox", "Registra débitos/créditos, auditoria e publica eventos")
  ContainerDb(db_lancamentos, "Banco de lançamentos", "Persistência transacional", "Movimentações, auditoria e Outbox")
  ContainerQueue(mensageria, "Mensageria", "Broker (a definir)", "Entrega eventos para consolidação")
  Container(consolidado, "Serviço de consolidado", "API REST + consumidor", "Atualiza projeções e consulta saldos")
  ContainerDb(db_consolidado, "Banco do consolidado", "Persistência de projeções", "Saldos por comerciante/data e IDs processados")
  Container(telemetria, "Coletor de observabilidade", "OTel Collector (proposto)", "Recebe métricas, traces e logs estruturados")
}
Rel(comerciante, web, "Registra e consulta", "HTTPS")
Rel(admin, web, "Administra acessos", "HTTPS")
Rel(web, gateway, "Consome APIs", "HTTPS / JSON + Bearer JWT")
Rel(web, iam, "Realiza login e obtém tokens", "OIDC / HTTPS (proposto)")
Rel(gateway, lancamentos, "Encaminha operações financeiras", "HTTPS / REST")
Rel(gateway, consolidado, "Encaminha consultas", "HTTPS / REST")
Rel(gateway, iam, "Encaminha administração de acessos", "HTTPS / REST")
Rel(iam, db_iam, "Mantém identidades e permissões", "SQL / TCP (proposto)")
Rel(lancamentos, db_lancamentos, "Grava lançamento + Outbox; worker busca eventos", "SQL / TCP (proposto)")
Rel(lancamentos, mensageria, "Publica eventos pelo worker interno", "AMQP 0-9-1 (proposto)")
Rel(mensageria, consolidado, "Entrega eventos financeiros", "AMQP 0-9-1 (proposto)")
Rel(consolidado, db_consolidado, "Atualiza e consulta projeções", "SQL / TCP (proposto)")
Rel(lancamentos, iam, "Atualiza cache de chaves JWT", "JWKS / HTTPS (proposto)")
Rel(consolidado, iam, "Atualiza cache de chaves JWT", "JWKS / HTTPS (proposto)")
Rel(iam, telemetria, "Exporta telemetria sem segredos", "OTLP / gRPC (proposto)")
Rel(lancamentos, telemetria, "Exporta telemetria", "OTLP / gRPC (proposto)")
Rel(consolidado, telemetria, "Exporta telemetria", "OTLP / gRPC (proposto)")
Rel(gateway, telemetria, "Exporta telemetria", "OTLP / gRPC (proposto)")
SHOW_LEGEND()
@enduml
