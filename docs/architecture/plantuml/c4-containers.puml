@startuml CashFlow_Containers
!include <C4/C4_Container>
title CashFlow | C4 Nível 2: Contêineres (proposta)
LAYOUT_LEFT_RIGHT()
Person(comerciante, "Comerciante", "Registra lançamentos e consulta o saldo")
System_Ext(identidade, "Provedor de identidade", "OIDC / OAuth 2.0, produto a definir")
System_Boundary(cashflow, "CashFlow") {
  Container(lancamentos, "Serviço de lançamentos", "API REST + Outbox worker", "Registra lançamentos e publica eventos pendentes em segundo plano")
  ContainerDb(db_lancamentos, "Banco de lançamentos", "Persistência transacional", "Registros financeiros e eventos Outbox")
  ContainerQueue(mensageria, "Mensageria", "Broker (a definir)", "Entrega eventos com retentativas")
  Container(consolidado, "Serviço de consolidado", "API REST + consumidor", "Atualiza e consulta saldos diários")
  ContainerDb(db_consolidado, "Banco do consolidado", "Persistência de projeções", "Saldos por data e IDs processados")
  Container(telemetria, "Coleta de observabilidade", "Collector / agente (proposta)", "Centraliza traces, métricas e logs")
}
Rel(comerciante, identidade, "Autentica usuário", "OIDC / HTTPS (proposto)")
Rel(comerciante, lancamentos, "Registra débito/crédito", "HTTPS / JSON + Bearer token")
Rel(comerciante, consolidado, "Consulta saldo diário", "HTTPS / JSON + Bearer token")
Rel(lancamentos, identidade, "Obtém chaves para validação local de JWT", "JWKS / HTTPS (proposto)")
Rel(consolidado, identidade, "Obtém chaves para validação local de JWT", "JWKS / HTTPS (proposto)")
Rel(lancamentos, db_lancamentos, "Grava lançamento + Outbox; worker busca pendências", "SQL / TCP (proposto)")
Rel(lancamentos, mensageria, "Publica eventos pelo worker interno", "AMQP 0-9-1 (proposto)")
Rel(mensageria, consolidado, "Entrega eventos de lançamento", "AMQP 0-9-1 (proposto)")
Rel(consolidado, db_consolidado, "Atualiza projeção e consulta saldo", "SQL / TCP (proposto)")
Rel(lancamentos, telemetria, "Exporta telemetria", "OTLP / gRPC (proposto)")
Rel(consolidado, telemetria, "Exporta telemetria", "OTLP / gRPC (proposto)")
SHOW_LEGEND()
@enduml
