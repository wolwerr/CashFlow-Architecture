@startuml CashFlow_Containers
!include <C4/C4_Container>
title CashFlow | C4 Nível 2: Contêineres (proposta)
LAYOUT_LEFT_RIGHT()
Person(comerciante, "Comerciante", "Autentica-se, registra lançamentos e consulta saldo")
System_Boundary(cashflow, "CashFlow") {
  Container(iam, "Serviço de Identidade e Acessos", "API / IAM (a definir)", "Autenticação, cadastro, grupos e permissões por comerciante")
  ContainerDb(db_iam, "Banco de identidade e acessos", "Persistência (a definir)", "Usuários, vínculos, grupos, papéis e dados de autenticação")
  Container(lancamentos, "Serviço de lançamentos", "API REST + Outbox worker", "Registra lançamentos e publica eventos pendentes")
  ContainerDb(db_lancamentos, "Banco de lançamentos", "Persistência transacional", "Registros, auditoria e eventos Outbox")
  ContainerQueue(mensageria, "Mensageria", "Broker (a definir)", "Entrega eventos com retentativas")
  Container(consolidado, "Serviço de consolidado", "API REST + consumidor", "Atualiza e consulta saldos diários")
  ContainerDb(db_consolidado, "Banco do consolidado", "Persistência de projeções", "Saldos por data e IDs processados")
  Container(telemetria, "Coleta de observabilidade", "Collector / agente (proposta)", "Recebe telemetria dos serviços")
}
Rel(comerciante, iam, "Login e gestão de acessos autorizada", "HTTPS / OIDC (proposto)")
Rel(comerciante, lancamentos, "Registra débito/crédito", "HTTPS / JSON + Bearer JWT")
Rel(comerciante, consolidado, "Consulta saldo diário", "HTTPS / JSON + Bearer JWT")
Rel(iam, db_iam, "Gerencia usuários, vínculos e permissões", "SQL / TCP (proposto)")
Rel(lancamentos, iam, "Consulta chaves públicas para validar JWT localmente", "JWKS / HTTPS (proposto)")
Rel(consolidado, iam, "Consulta chaves públicas para validar JWT localmente", "JWKS / HTTPS (proposto)")
Rel(lancamentos, db_lancamentos, "Grava lançamento + Outbox; worker busca pendências", "SQL / TCP (proposto)")
Rel(lancamentos, mensageria, "Publica eventos pelo worker interno", "AMQP 0-9-1 (proposto)")
Rel(mensageria, consolidado, "Entrega eventos de lançamento", "AMQP 0-9-1 (proposto)")
Rel(consolidado, db_consolidado, "Atualiza projeção e consulta saldo", "SQL / TCP (proposto)")
Rel(iam, telemetria, "Exporta telemetria sem segredos", "OTLP / gRPC (proposto)")
Rel(lancamentos, telemetria, "Exporta telemetria", "OTLP / gRPC (proposto)")
Rel(consolidado, telemetria, "Exporta telemetria", "OTLP / gRPC (proposto)")
SHOW_LEGEND()
@enduml
