@startuml CashFlow_UseCases
title CashFlow | Casos de Uso
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
 BackgroundColor #E8F2FF
 BorderColor #356DA8
 FontColor #18365C
}
actor "Comerciante" as comerciante
rectangle "CashFlow" {
  usecase "UC-01\nRegistrar crédito" as UC01
  usecase "UC-02\nRegistrar débito" as UC02
  usecase "UC-03\nConsultar consolidado diário" as UC03
  usecase "UC-04\nConsultar histórico\n(proposto)" as UC04
  usecase "UC-05\nEstornar lançamento\n(proposto)" as UC05
}
comerciante --> UC01
comerciante --> UC02
comerciante --> UC03
comerciante --> UC04
comerciante --> UC05
legend bottom
  UC-01 a UC-03: exigidos pelo desafio
  UC-04 e UC-05: propostas a validar
endlegend
@enduml
