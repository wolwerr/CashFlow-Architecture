@startuml CashFlow_Frontend_Components
!include <C4/C4_Component>

title CashFlow | C4 Nível 3: Aplicação Web React
LAYOUT_LEFT_RIGHT()

Person(user, "Comerciante / administrador", "Usa o navegador para operações financeiras")
Container_Ext(nginx, "NGINX", "HTTP interno :8080; HTTPS público :443 previsto", "Entrega assets React e encaminha /api/v1/*")
Container_Ext(keycloak, "Keycloak", "OIDC / OAuth 2.0, HTTPS :443 público", "Autentica usuários com Authorization Code + PKCE")
Container_Ext(transactions, "Transactions API", "ASP.NET Core, HTTP interno :8080", "Registra créditos/débitos e consulta histórico")
Container_Ext(consolidation, "Consolidation API", "ASP.NET Core, HTTP interno :8080", "Consulta saldos diários")

Container_Boundary(frontend, "Aplicação Web | React + TypeScript") {
  Component(shell, "App Shell e rotas", "React / TypeScript", "Inicialização, navegação e layout responsivo")
  Component(auth, "Autenticação OIDC", "OIDC Authorization Code + PKCE", "Login/logout e PKCE; tokens apenas em memória")
  Component(access, "Estado de sessão e permissões", "React / TypeScript", "Protege rotas por sessão; não substitui autorização das APIs")
  Component(form, "Tela de lançamentos", "React / TypeScript", "Data Sao_Paulo atual editavel, BRL e Idempotency-Key")
  Component(balance, "Tela de consolidado", "React / TypeScript", "Exibe líquido e acumulado por data/comerciante")
  Component(api, "Cliente HTTP CashFlow", "Fetch / REST / JSON", "Inclui Bearer/Idempotency-Key; usa /api/v1/*")
  Component(ui, "Componentes de interface", "React / TypeScript", "Estados de carregamento, erros, acessibilidade e componentes compartilhados")
}

Rel(user, nginx, "Abre a aplicação", "HTTPS :443")
Rel(nginx, shell, "Entrega HTML, JS, CSS", "HTTPS :443 via navegador")
Rel(shell, auth, "Inicializa sessão OIDC")
Rel(shell, access, "Controla navegação conforme sessão")
Rel(shell, form, "Exibe lançamentos")
Rel(shell, balance, "Exibe consulta")
Rel(form, ui, "Usa componentes e mensagens")
Rel(balance, ui, "Usa componentes e mensagens")
Rel(form, api, "Registra crédito ou débito")
Rel(balance, api, "Consulta saldo diário")
Rel(api, auth, "Obtém access token válido")
Rel(auth, keycloak, "Redirect, code + PKCE; tokens via endpoint OIDC", "HTTPS :443 público")
Rel(api, nginx, "Chama /api/v1/transactions/* e /api/v1/consolidation/*", "HTTPS :443 / REST + Bearer JWT")
Rel(nginx, transactions, "Proxy /api/v1/transactions/*", "HTTP :8080 na rede privada")
Rel(nginx, consolidation, "Proxy /api/v1/consolidation/*", "HTTP :8080 na rede privada")

SHOW_LEGEND()
@enduml
