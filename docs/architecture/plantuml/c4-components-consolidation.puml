@startuml CashFlow_Consolidation_Components
!include <C4/C4_Component>

title CashFlow | C4 Nível 3: Serviço Consolidation (Consolidado Diário)
LAYOUT_LEFT_RIGHT()

Container_Ext(nginx, "NGINX", "Reverse proxy", "Encaminha consultas autenticadas")
Container_Ext(keycloak, "Keycloak", "OIDC / JWKS", "Emite tokens; APIs validam JWT localmente")
ContainerQueue_Ext(rabbit, "RabbitMQ", "AMQP 0-9-1", "Entrega eventos de Transactions")
ContainerDb_Ext(consolidationDb, "Banco de Consolidation", "PostgreSQL / EF Core", "DailyBalance e ProcessedEvent")
Container_Ext(otel, "OpenTelemetry Collector", "OTLP", "Recebe telemetria técnica")

Container_Boundary(consolidation, "Consolidation | API + consumidor (.NET 10)") {
  Component(api, "Endpoints de consulta", "ASP.NET Core", "REST: consulta consolidado e validação JWT")
  Component(auth, "Autorização por comerciante", "Application / Policy", "Valida acesso do sujeito ao merchant_id")
  Component(query, "Consultar saldo diário", "Application", "Executa consultas sem acessar Transactions")
  Component(consumer, "RabbitMQ Consumer", "Host / Infrastructure", "Recebe eventos, controla ACK após commit e retries")
  Component(process, "Processar lançamento", "Application", "Valida evento, aplica idempotência e atualiza projeção")
  Component(domain, "Modelo de consolidação", "Domain", "Regras de agregação diária, precisão e invariantes")
  Component(ports, "Portas de projeção e deduplicação", "Application", "Interfaces para consultas e update transacional")
  Component(repo, "Repositórios + Unit of Work", "Infrastructure / EF Core", "Consulta DailyBalance; grava saldo + ProcessedEvent atomicamente")
}

Rel(nginx, api, "Consulta saldo diário", "HTTPS / JSON")
Rel(api, keycloak, "Busca chaves públicas quando necessário; valida JWT localmente", "HTTPS / JWKS")
Rel(api, auth, "Verifica acesso do comerciante")
Rel(auth, query, "Autoriza consulta")
Rel(api, query, "Consulta")
Rel(query, ports, "Busca projeção")
Rel(consumer, rabbit, "Consome eventos", "AMQP")
Rel(consumer, process, "Entrega evento para aplicação")
Rel(process, domain, "Calcula atualização do saldo")
Rel(process, ports, "Exige atualização idempotente")
Rel(repo, ports, "Implementa interfaces")
Rel(repo, consolidationDb, "Consulta saldos; grava DailyBalance + ProcessedEvent", "SQL")
Rel(consumer, rabbit, "ACK somente após commit; NACK/retry em falha", "AMQP")
Rel(api, otel, "Emite sinais técnicos", "OTLP")
Rel(consumer, otel, "Emite sinais técnicos", "OTLP")

note bottom of process
  A deduplicação por event_id e a
  atualização de DailyBalance devem
  ocorrer na mesma transação.
  Reentregas não podem duplicar saldo.
end note

note bottom of query
  O banco de Transactions não é
  consultado por Consolidation.
  A projeção pode ficar temporariamente
  desatualizada, conforme ADR-005.
end note

SHOW_LEGEND()
@enduml
