# Copie para .env e substitua as senhas somente no computador local.
# Uso exclusivo para Docker Compose LOCAL. Nunca versionar .env.
# Evite espaços, aspas, # ou $ em senhas até validar a interpolação do Compose.
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_LOCAL_POSTGRES
RABBITMQ_PASSWORD=SUBSTITUA_POR_SENHA_LOCAL_RABBITMQ

# Obrigatoria para iniciar o Grafana pelo compose.yaml principal.
# Defina uma senha forte apenas no arquivo .env local, nunca no Git.
CASHFLOW_GRAFANA_PASSWORD=SUBSTITUA_POR_SENHA_LOCAL_GRAFANA
# Conta TEMPORARIA de bootstrap do realm master. Nome de usuario: admin.
# O campo abaixo e um MARCADOR, NAO e uma senha valida pronta.
# Antes do primeiro 'docker compose up', substitua o valor por uma senha
# forte escolhida por voce. O Keycloak NAO exige troca automatica no primeiro login.
# Depois, crie um administrador permanente no master e exclua o temporario.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=DEFINA_AQUI_SUA_SENHA_INICIAL_FORTE
CASHFLOW_BOOTSTRAP_USERNAME=cashflow.admin

# Inicialmente ficam sem valor. Após subir o realm cashflow, copie os secrets
# dos clientes confidenciais na interface administrativa do Keycloak.
KEYCLOAK_AUTHZ_CLIENT_SECRET=
KEYCLOAK_MGMT_CLIENT_SECRET=
