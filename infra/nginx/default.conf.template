# Template for the official nginx container, expanded by envsubst at startup.
# This is the MVP reverse proxy, NOT a dedicated API management gateway.
# Required variables: TRANSACTIONS_UPSTREAM and CONSOLIDATION_UPSTREAM.
# Example: transactions:8080 and consolidation:8080 on a private Docker network.
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # React SPA. The frontend build must be mounted/copied into root.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # MVP versioned API prefixes; keep URI unmodified for upstream contracts.
    # Regex uses boundary so /api/v1/transactions-extra cannot match.
    location ~ ^/api/v1/transactions(?:/|$) {
        proxy_pass http://${TRANSACTIONS_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Idempotency-Key $http_idempotency_key;
        proxy_set_header X-Correlation-ID $http_x_correlation_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location ~ ^/api/v1/consolidation(?:/|$) {
        proxy_pass http://${CONSOLIDATION_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Correlation-ID $http_x_correlation_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # Basic health check for the reverse proxy process, not upstream readiness.
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
