{
  "realm": "cashflow",
  "enabled": true,
  "displayName": "CashFlow (local development)",
  "registrationAllowed": false,
  "editUsernameAllowed": true,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "cashflow-transactions-api",
      "name": "CashFlow Transactions API audience",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "cashflow-consolidation-api",
      "name": "CashFlow Consolidation API audience",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "cashflow-spa",
      "name": "CashFlow React SPA (PKCE)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "transactions-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "cashflow-transactions-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "consolidation-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "cashflow-consolidation-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "cashflow-authorization-service",
      "name": "CashFlow Authorization (server-to-server only)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "description": "Confidential service client: configure realm-management view-users only, then set KEYCLOAK_AUTHZ_CLIENT_SECRET locally. Never expose the secret to SPA."
    },
    {
      "clientId": "cashflow-management-service",
      "name": "CashFlow Merchant Management (server-to-server only)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "description": "Separate confidential admin client. Grant realm-management manage-realm, manage-users, view-users, query-users to its service account. Set KEYCLOAK_MGMT_CLIENT_SECRET only in local .env."
    }
  ]
}
